<UserControl x:Class="WpfOpenPrograms.Pages.Select"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfOpenPrograms.Pages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" MinWidth="630" MinHeight="430">
    <UserControl.Background>
        <LinearGradientBrush>
            <GradientStop Color="#0F2027" Offset="0.0" />
            <GradientStop Color="#2C5364" Offset="0.50" />
        </LinearGradientBrush>
    </UserControl.Background>
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Click="OpenPaint" Margin="10,0" Content="Paint" HorizontalAlignment="Center" FontFamily="Arial" FontSize="16" FontWeight="Bold">
                
            </Button>
            <Button Click="OpenNotepad" Margin="10,0" Content="Notepad" HorizontalAlignment="Center" FontFamily="Arial" FontSize="16" FontWeight="Bold">
                
            </Button>
            <Button Click="OpenCalculator" Margin="10,0" Content="Calculator" HorizontalAlignment="Center" FontFamily="Arial" FontSize="16" FontWeight="Bold">
                
            </Button>
            <Button Click="OpenExploler" Margin="10,0" Content="Exploler" HorizontalAlignment="Center" FontFamily="Arial" FontSize="16" FontWeight="Bold">
                
            </Button>
        </StackPanel>
    </Grid>
</UserControl>